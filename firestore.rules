rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Product catalogue: anyone can read, only trusted admins can write.
    // Writes are done via seed scripts/Firebase console, so no client write rule is granted.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;

      // Reviews live under each product. Anyone can read; only a signed-in
      // user can create a review, and only as themselves (no editing/deleting
      // other people's reviews, and no editing after posting in this simple flow).
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update, delete: if false;
      }
    }

    // Each user's cart lives at users/{userId}/cart/items.
    // Only that authenticated user may read or write it.
    match /users/{userId}/cart/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Each user's wishlist lives at users/{userId}/wishlist/items.
    // Only that authenticated user may read or write it.
    match /users/{userId}/wishlist/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
